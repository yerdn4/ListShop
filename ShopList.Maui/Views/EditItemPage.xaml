<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ShopList.Maui.ViewModels"
             xmlns:models="clr-namespace:ShopList.Maui.Models"
             x:Class="ShopList.Maui.Views.EditItemPage"
             Title="Detalles del Articulo">
    
    <ContentPage.BindingContext>
        <viewmodel:EditItemViewModel/>
    </ContentPage.BindingContext>
    
    <Grid 
        Padding="16">
        
        <VerticalStackLayout 
            VerticalOptions="Start" 
            Spacing="8">
            
            <Label Text="Nombre del articulo"/>
            
            <Entry Placeholder="Ejemplo: Manzanas"
             BackgroundColor="WhiteSmoke"/>
            <Label Text="cantidad"/>
            
            <Entry Text="1" BackgroundColor="WhiteSmoke"/>
            
            <HorizontalStackLayout HorizontalOptions="End">
                <CheckBox 
                    />
                <Label Text="Comprado"
                VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <Button Text="Guardar"
                 HorizontalOptions="Fill"
                 Margin="0,24,0,0"
                    Command="{Binding Path=SaveCommand}"/>

        </VerticalStackLayout>

    </Grid>
</ContentPage>